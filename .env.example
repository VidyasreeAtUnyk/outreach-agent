# Copy this file to .env.local and fill in every value below.
# Validated at startup by src/lib/env.ts — the app refuses to run if any
# required variable is missing or malformed.

# --- Supabase ---------------------------------------------------------------
# Project Settings > API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service-role key — server-only, bypasses RLS. Never expose this to the
# client. Used only by scripts/seed.ts (see lib/supabase/service.ts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- OpenAI ------------------------------------------------------------------
# https://platform.openai.com/api-keys — used for research synthesis,
# combined email drafting + confidence scoring, and reply-response
# suggestions. Every call is counted against a hard 50-call budget tracked
# in the openai_usage table — see docs/decisions/05-external-api-budgets.md.
OPENAI_API_KEY=sk-your-openai-key
# Defaults to gpt-5.4-mini if unset.
OPENAI_MODEL=gpt-5.4-mini

# --- Tavily --------------------------------------------------------------
# https://tavily.com — web search used in the research pipeline. Metered
# against a 1000 credits/month budget tracked in the tavily_usage table —
# see docs/decisions/02-tavily-over-raw-search.md and
# docs/decisions/05-external-api-budgets.md.
TAVILY_API_KEY=your-tavily-key

# --- Contact lookup: Apollo.io + Hunter.io (both optional) ------------------
# Finds CEO/CTO email addresses during research. lib/integrations/contact-lookup.ts
# tries Apollo first, then Hunter, and skips whichever key is unset — if
# neither is set, contacts are just flagged for manual entry in the review
# UI instead. See docs/decisions/06-apollo-alongside-hunter.md. Apollo is
# additionally metered against a 90 credits/cycle budget tracked in the
# apollo_usage table — see docs/decisions/05-external-api-budgets.md.
# https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your-apollo-key
# https://hunter.io
HUNTER_API_KEY=your-hunter-key

# --- Resend (Phase 2 — not used yet) ---------------------------------------
# Optional. Nothing in the app calls this yet — see
# docs/decisions/04-review-before-send.md for why sending stays manual in
# Phase 1. Only needed once that phase is implemented.
RESEND_API_KEY=

# --- scripts/seed.ts (optional) ---------------------------------------------
# Which Supabase auth user to attach seed data to. If unset, the seed
# script uses the first user it finds in the project.
SEED_USER_ID=
